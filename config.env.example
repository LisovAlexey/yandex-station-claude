# Copy this file to config.env and fill in your own values.
# config.env is gitignored and never committed.

# --- Yandex Station (the jailbroken speaker) -------------------------------
# SSH target and port of the rooted Station (root over dropbear on 2222 is typical).
STATION_HOST=root@192.168.1.X
STATION_SSH_PORT=2222

# --- Claude proxy endpoint -------------------------------------------------
# The claude-max-api-proxy URL the bridge will call, reachable FROM the speaker.
# Use https:// and install the proxy's CA on the speaker (see README).
PROXY_URL=https://192.168.1.Y/v1
PROXY_MODEL=sonnet

# --- Build sources (forks with the patches) --------------------------------
BRIDGE_REPO=https://github.com/LisovAlexey/quasar-bridge.git
BRIDGE_REF=feat/wakeword-llm-claim
WAKEWORD_REPO=https://github.com/LisovAlexey/station-wakeword.git
WAKEWORD_REF=feat/llm-claim-on-hit

# --- Paths on the speaker (defaults match a rooted Station Mini) -----------
BRIDGE_DIR=/data/quazar/yam/data/plugins/quasar-bridge
BRIDGE_STATE=/data/opt/quasar-bridge
WAKEWORD_DIR=/data/wakeword

# --- Local build artifacts (produced by scripts/build.sh) ------------------
BRIDGE_BIN=dist/quasar-bridge.arm64
WAKEWORD_BIN=dist/wakeword.arm64
WAKEWORD_INIT=config/S97wakeword

# --- Optional -------------------------------------------------------------
# If your ssh-agent socket is not already in the environment, set it here.
# SSH_AUTH_SOCK=/path/to/agent.sock
